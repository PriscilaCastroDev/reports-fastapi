# Base de datos (ClickHouse)
DB_HOST=localhost
DB_PORT=8123
DB_NAME=db
DB_USER=user
DB_PASSWORD=password

# App
APP_HOST=0.0.0.0
APP_PORT=4002
LOG_LEVEL=INFO

# CORS — separar múltiples orígenes con coma
CORS_ORIGINS=http://localhost:0000

# Límites
MAX_ROWS_SYNC=100000

# Scheduler — persistencia SQLite (en contenedor: /app/data/schedules.db)
SQLITE_PATH=data/schedules.db

# Scheduler — SMTP Gmail (SMTP_PASSWORD = App Password de 16 caracteres)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reportes.telecom@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
